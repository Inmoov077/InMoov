# Copy to .env and set your keys
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Ollama base URL for local chat
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional: default serial port override (e.g. COM5 / /dev/ttyUSB0)
# INMOOVE_SERIAL_PORT=

# Optional: disable auto-start of background services
# INMOOVE_AUTO_PRESENCE=0
